# ============================================================
# TrustLance — Root Environment Variables Example
# Copy relevant sections to /server/.env and /contracts/.env
# ============================================================

# --- Blockchain ---
# For local Hardhat dev, leave SEPOLIA blank
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Contract addresses (auto-filled by deploy script)
ESCROW_FACTORY_ADDRESS=
REPUTATION_SBT_ADDRESS=
STAKING_BOND_ADDRESS=
BAN_REGISTRY_ADDRESS=

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/trustlance

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_64_chars

# --- AI (Claude) ---
# Leave blank to use mock AI service
ANTHROPIC_API_KEY=

# --- IPFS ---
# Leave blank to use local file mock
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# --- Email ---
# Leave blank to use console mock
RESEND_API_KEY=
EMAIL_FROM=noreply@trustlance.app

# --- Pricing ---
COINGECKO_API_KEY=

# --- Platform Config ---
DUAL_CONFIRM_THRESHOLD_USD=500
INACTIVITY_WARN_DAYS=3
INACTIVITY_AUTO_DISPUTE_DAYS=7
AI_CONFIDENCE_THRESHOLD=0.75
PLATFORM_FEE_BPS=50
PORT=3001
